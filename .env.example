# ============================================================
# ZombieCoder Runtime v0.48 — environment example
# ============================================================
# Copy this file to .env and change secrets/URLs/models.
# Do not commit a real .env file or real API keys.

# ---------------- Runtime ----------------
HOST=127.0.0.1
PORT=3000
ADMIN_TOKEN=replace-with-a-long-random-admin-token
# Local-only unauthenticated testing. Keep false on servers and behind reverse proxies.
LOCAL_AUTH_BYPASS=false
RUNTIME_SECRET=replace-with-a-long-random-runtime-secret
ALLOW_PLAINTEXT_HTTP=false
# Safe default: chat only. Change to tools-enabled only after local verification passes.
ZOMBIECODER_EXECUTION_MODE=chat-only
DATA_DIR=./data
SQLITE_PATH=./data/runtime.sqlite
MIGRATE_JSON_ON_START=false

# Optional HTTPS / UDS
HTTPS_ENABLED=false
HTTPS_REQUIRED=false
HTTPS_HOST=127.0.0.1
HTTPS_PORT=10443
HTTPS_KEY=./certs/server.key
HTTPS_CERT=./certs/server.crt
UDS_ENABLED=false
UDS_REQUIRED=false
UDS_PATH=./data/runtime.sock

# ---------------- Provider routing ----------------
# The runtime is provider-neutral. Add providers through PROVIDER_CONFIG_JSON.
# API keys are looked up as PROVIDER_KEY_<PROVIDER_ID>, with '_' normalized to '-'.
# Example: provider id "opencode-free" -> PROVIDER_KEY_OPENCODE_FREE

# Default local/self-hosted compatible endpoint.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Private provider destinations are denied by default. To use local Ollama while
# still allowing public providers, explicitly opt in for the exact loopback host:
# PROVIDER_ALLOW_PRIVATE_NETWORK=true
# PROVIDER_ALLOW_PRIVATE_HOSTS=127.0.0.1

PROVIDER_KEY_OLLAMA_LOCAL=

# Ollama Cloud: OpenAI-compatible endpoint (/v1).
# Put your Ollama Cloud key here if you want to test the cloud endpoint.
PROVIDER_KEY_OLLAMA_CLOUD_OPENAI=

# Ollama Cloud: native Ollama API (/api/*). The adapter sends the same bearer key.
PROVIDER_KEY_OLLAMA_CLOUD_NATIVE=

# Native Gemini driver uses the Gemini generateContent API.
PROVIDER_KEY_GEMINI=

# Groq uses its OpenAI-compatible API.
PROVIDER_KEY_GROQ=

# Cloudflare Workers AI OpenAI-compatible endpoint.
# Replace YOUR_ACCOUNT_ID with the real Cloudflare account id.
PROVIDER_KEY_CLOUDFLARE=

# OpenCode-compatible/custom OpenAI-compatible endpoint.
# The runtime does not assume a provider-owned endpoint here; put the actual
# endpoint supplied by your provider/gateway in the config below.
PROVIDER_KEY_OPENCODE_FREE=

# Generic custom OpenAI-compatible provider.
PROVIDER_KEY_CUSTOM_1=

# Provider bootstrap. Keep optional providers disabled until their endpoint,
# model, credentials, and network policy are actually configured and tested.
# JSON is intentionally one line because .env parsing differs between loaders.
PROVIDER_CONFIG_JSON=[{"id":"ollama-local","name":"Ollama Local","driver":"ollama","protocol":"openai-compatible","baseUrl":"http://127.0.0.1:11434/v1","defaultModel":"REPLACE_WITH_OLLAMA_MODEL","models":[],"enabled":true,"capabilities":["chat-completions","streaming","function-calling","model-catalog"],"priority":1},{"id":"ollama-cloud-openai","name":"Ollama Cloud OpenAI Compatible","driver":"ollama","mode":"openai-compatible","protocol":"openai-compatible","baseUrl":"https://ollama.com/v1","defaultModel":"REPLACE_WITH_OLLAMA_CLOUD_MODEL","models":[],"enabled":false,"capabilities":["chat-completions","streaming","function-calling","model-catalog"],"priority":2},{"id":"ollama-cloud-native","name":"Ollama Cloud Native","driver":"ollama","mode":"native","protocol":"ollama-native","baseUrl":"https://ollama.com","defaultModel":"REPLACE_WITH_OLLAMA_CLOUD_MODEL","models":[],"enabled":false,"capabilities":["chat-completions","streaming","function-calling","model-catalog"],"priority":3},{"id":"gemini","name":"Google Gemini","driver":"gemini","protocol":"gemini-generate-content","baseUrl":"https://generativelanguage.googleapis.com/v1beta","defaultModel":"REPLACE_WITH_SUPPORTED_GEMINI_MODEL","models":[],"enabled":false,"capabilities":["generate-content","streaming","function-calling","model-catalog"],"priority":4},{"id":"groq","name":"Groq","driver":"groq","protocol":"openai-compatible","baseUrl":"https://api.groq.com/openai/v1","defaultModel":"REPLACE_WITH_SUPPORTED_GROQ_MODEL","models":[],"enabled":false,"capabilities":["chat-completions","streaming","function-calling","model-catalog"],"priority":5},{"id":"cloudflare","name":"Cloudflare Workers AI","driver":"cloudflare","protocol":"openai-compatible","baseUrl":"https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1","defaultModel":"REPLACE_WITH_SUPPORTED_CLOUDFLARE_MODEL","models":[],"enabled":false,"capabilities":["chat-completions","streaming","function-calling","model-catalog"],"priority":6},{"id":"opencode-free","name":"OpenCode Compatible Endpoint","driver":"openai-compatible","protocol":"openai-compatible","baseUrl":"https://REPLACE_WITH_OPENCODE_COMPATIBLE_ENDPOINT/v1","defaultModel":"REPLACE_WITH_SUPPORTED_MODEL","models":[],"enabled":false,"capabilities":["chat-completions","streaming","function-calling","model-catalog"],"priority":7},{"id":"custom-1","name":"Custom Provider 1","driver":"openai-compatible","protocol":"openai-compatible","baseUrl":"https://REPLACE_WITH_CUSTOM_ENDPOINT/v1","defaultModel":"REPLACE_WITH_SUPPORTED_MODEL","models":[],"enabled":false,"capabilities":["chat-completions","streaming","function-calling","model-catalog"],"priority":8}]

# Optional provider catalog sync (remote catalog must itself be trusted/allowed).
PROVIDER_CATALOG_SYNC_URL=
PROVIDER_CATALOG_SYNC_ON_START=false
# Optional live refresh of models from each configured provider at startup.
PROVIDER_MODELS_REFRESH_ON_START=false
PROVIDER_CATALOG_API_KEY=
PROVIDER_SYNC_TIMEOUT_MS=30000

# ---------------- Network policy ----------------
PROVIDER_ALLOW_HOSTS=
PROVIDER_ALLOW_PRIVATE_NETWORK=false
PROVIDER_ALLOW_PRIVATE_HOSTS=
MAX_PROVIDER_RESPONSE_BYTES=4194304
MAX_BODY_BYTES=4194304

# ---------------- MCP ----------------
MCP_CONNECTION_LEASE_MS=300000
MCP_RECONCILE_ON_START=false
MCP_RECONCILIATION_GRACE_MS=30000
EXTERNAL_MCP_URLS=
EXTERNAL_MCP_SCREEN_RECORDER_URL=
LOCAL_MCP_FALLBACK_ENABLED=false
# For local fallback only, explicitly allow HTTP/private transport; each fallback entry pins its host to 127.0.0.1.
# MCP_ALLOW_HTTP=true
# MCP_ALLOW_PRIVATE_NETWORK=true
# EXTERNAL_MCP_PUBLIC_API_URL=https://example.invalid/mcp
# EXTERNAL_MCP_TTS_URL=https://example.invalid/mcp
# EXTERNAL_MCP_OCR_URL=https://example.invalid/mcp
# EXTERNAL_MCP_FACEBOOK_ADS_URL=https://example.invalid/mcp

# ---------------- Tool / execution limits ----------------
TOOL_LOOP_MAX_ROUNDS=8
TOOL_LOOP_MAX_TOOL_CALLS_PER_ROUND=8
TOOL_LOOP_MAX_REPEATED_CALLS=2
SESSION_MAX_MESSAGES=100
ZOMBIECODER_TOOLS=
# ZOMBIECODER_TOOL_READ_FILE=true
# ZOMBIECODER_TOOL_WRITE_FILE=false

# ---------------- Session / context ----------------
MEMORY_MAX_ENTRIES=500
CONTEXT_BUDGET_BYTES=1048576
COMPILED_CONTEXT_BYTES=196608
CONTEXT_RECENT_MESSAGES=10
PROJECT_ROOTS=

# ---------------- Observability ----------------
ENV_FILE=.env
ENV_LOADER_ENABLED=true
LOG_LEVEL=info
LOG_DIR=./logs
LOG_FILE=runtime.jsonl
LOG_TO_STDOUT=true
LOG_MAX_BYTES=10485760
LOG_MAX_FILES=7
LOG_PAYLOADS=false

# ---------------- Reliability ----------------
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_TIMEOUT_MS=15000
CIRCUIT_HALF_OPEN_MAX_CALLS=1

# ---------------- Optional browser/CDP ----------------
CDP_USER_DATA_DIR=
CDP_SYNC_URL=

# ---------------- Instance identity ----------------
RUNTIME_ID=
INSTANCE_ID=

# External MCP security policy. Defaults deny plaintext HTTP and private destinations.
MCP_ALLOW_HTTP=false
MCP_ALLOW_PRIVATE_NETWORK=false
# Exact host allowlist, comma-separated; required with HTTP/private MCP access.
MCP_ALLOW_HOSTS=
